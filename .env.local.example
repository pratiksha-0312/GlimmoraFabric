# Glimmora Fabric — frontend environment configuration
#
# Copy this file to `.env.local` and adjust values for your environment.

# ----------------------------------------------------------------------------
# Database (Postgres — e.g. Neon)
# ----------------------------------------------------------------------------
# Used by Prisma at runtime via src/lib/prisma.ts (NEON_DATABASE_URL takes
# precedence) and by prisma CLI / migrations via prisma.config.ts (DATABASE_URL).
# For Neon, copy the pooled connection string from the project dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ----------------------------------------------------------------------------
# Backend API
# ----------------------------------------------------------------------------
# Base URL of the FastAPI Identity & Access Service.
# Do NOT include a trailing slash. The frontend client appends `/api/v1/...`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Stripe (kept for billing — unrelated to identity)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
