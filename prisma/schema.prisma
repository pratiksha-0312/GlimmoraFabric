generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String   @id @default(cuid())
  code        String   @default("")
  name        String
  username    String
  email       String
  plan        String   @default("Starter")
  users       Int      @default(0)
  region      String   @default("US-East")
  domain      String   @default("")
  status      String   @default("Provisioning")
  apiCalls    String   @default("—")
  description String   @default("")
  password    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  platformUsers PlatformUser[]

  @@map("tenants")
}

model PlatformUser {
  id         String   @id @default(cuid())
  code       String   @default("")
  name       String
  email      String
  password   String   @default("")
  role       String   @default("tenant_member")
  status     String   @default("Active")
  mfa        Boolean  @default(false)
  lastLogin  String   @default("—")
  tenant     String   @default("")
  tenantId    String?
  tenantRef   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  joinedDate  String   @default("")
  inviteToken String?  @unique
  phone       String   @default("")
  jobTitle    String   @default("")
  bio         String   @default("")
  timezone    String   @default("Asia/Kolkata (IST, UTC+5:30)")
  avatarUrl   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions  Session[]
  apiTokens ApiToken[]

  @@map("platform_users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String   @default("end_user")
  description String   @default("")
  status      String   @default("Active")
  permissions String   @default("{}") // JSON string of module permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     String   @default("")
  browser    String   @default("")
  ip         String   @default("")
  location   String   @default("")
  isCurrent  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("sessions")
}

model ApiToken {
  id        String   @id @default(cuid())
  userId    String
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  token     String   @unique
  scopes    String   @default("read")
  expiresAt DateTime?
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("api_tokens")
}

model SsoConfig {
  id         String  @id @default(cuid())
  tenantId   String?
  provider   String
  enabled    Boolean @default(false)
  config     String  @default("{}") // JSON string
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, tenantId])
  @@map("sso_configs")
}

// ---------------------------------------------------------------------------
// Payment models
// ---------------------------------------------------------------------------

model Subscription {
  id               String    @id @default(cuid())
  tenantId         String
  plan             String    // Starter, Pro, Enterprise
  status           String    @default("active") // active, cancelled, past_due, trialing
  stripeSubId      String?   @unique
  stripeCustId     String?
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id              String   @id @default(cuid())
  tenantId        String
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  stripePaymentId String?  @unique
  amount          Int      // in cents (e.g. 2900 = $29.00)
  currency        String   @default("usd")
  status          String   // succeeded, failed, pending, refunded
  receiptUrl      String?
  createdAt       DateTime @default(now())

  refunds Refund[]

  @@map("payments")
}

model StoredPaymentMethod {
  id             String   @id @default(cuid())
  tenantId       String
  stripeMethodId String   @unique
  brand          String
  last4          String
  expMonth       Int
  expYear        Int
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("payment_methods")
}

model Refund {
  id             String    @id @default(cuid())
  paymentId      String
  payment        Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  stripeRefundId String?   @unique
  amount         Int
  currency       String    @default("usd")
  reason         String    @default("")
  status         String    @default("pending") // pending, completed, rejected
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@map("refunds")
}

model Invoice {
  id              String   @id @default(cuid())
  tenantId        String
  stripeInvoiceId String?  @unique
  amount          Int
  currency        String   @default("usd")
  status          String   // paid, open, void
  pdfUrl          String?
  createdAt       DateTime @default(now())

  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Workflow models (P5-F01 Workflow Builder)
// ---------------------------------------------------------------------------

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  status      String   @default("Draft") // Draft, Published, Archived
  version     Int      @default(1)
  trigger     String   @default("Manual") // Manual, Event, API, Schedule
  nodes       String   @default("[]") // JSON array of workflow nodes
  edges       String   @default("[]") // JSON array of workflow edges
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions  WorkflowVersion[]
  instances WorkflowInstance[]

  @@map("workflows")
}

model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version     Int
  status      String   // Published, Draft
  changedBy   String
  summary     String   @default("")
  nodes       String   @default("[]") // JSON snapshot of nodes at this version
  edges       String   @default("[]") // JSON snapshot of edges at this version
  createdAt   DateTime @default(now())

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

// ---------------------------------------------------------------------------
// Workflow Monitoring models (P5-F02)
// ---------------------------------------------------------------------------

model WorkflowInstance {
  id           String   @id @default(cuid())
  workflowId   String
  workflow     Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggeredBy  String
  status       String   @default("Running") // Running, Completed, Failed, Cancelled
  currentStep  String   @default("")
  progress     Int      @default(0) // 0-100
  sla          String   @default("Within SLA") // Within SLA, At Risk, Breached
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelledBy  String?

  steps WorkflowStep[]

  @@map("workflow_instances")
}

model WorkflowStep {
  id           String   @id @default(cuid())
  instanceId   String
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  name         String
  type         String   // start, task, decision, end
  status       String   @default("pending") // pending, running, completed, failed
  assignee     String?
  result       String?
  startedAt    DateTime?
  completedAt  DateTime?
  sortOrder    Int      @default(0)

  @@map("workflow_steps")
}

// ---------------------------------------------------------------------------
// Task models (P5-F03 Task Inbox)
// ---------------------------------------------------------------------------

model Task {
  id                 String   @id @default(cuid())
  title              String
  type               String   @default("Approval") // Approval, Review, Escalation, Task
  workflow           String   @default("")
  workflowInstanceId String?
  priority           String   @default("Medium") // Urgent, High, Medium, Low
  status             String   @default("Pending") // Pending, Approved, Rejected, Completed
  assignee           String
  approver           String?
  requester          String
  description        String   @default("")
  metadata           String   @default("{}") // JSON string of task-specific metadata
  dueDate            DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  comments TaskComment[]
  history  TaskHistory[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    String
  text      String
  createdAt DateTime @default(now())

  @@map("task_comments")
}

model TaskHistory {
  id     String   @id @default(cuid())
  taskId String
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action String
  by     String
  at     DateTime @default(now())

  @@map("task_history")
}

// ---------------------------------------------------------------------------
// Document models
// ---------------------------------------------------------------------------

model Document {
  id           String    @id @default(cuid())
  name         String
  templateId   String?
  template     DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tenantId     String?
  tenant       String    @default("") // denormalized tenant display name
  status       String    @default("generated") // generated, pending_sign, signed, expired
  format       String    @default("pdf")
  size         String    @default("")
  createdBy    String
  auditJson    String    @default("[]") // JSON array: [{ action, actor, timestamp }]
  signedAt     DateTime?
  signedBy     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  signatures   DocumentSignature[]

  @@map("documents")
}

model DocumentSignature {
  id           String    @id @default(cuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signerName   String
  signerEmail  String
  status       String    @default("pending") // pending, signed, declined
  requestedAt  DateTime  @default(now())
  signedAt     DateTime?
  ip           String?
  sortOrder    Int       @default(0)

  @@index([documentId])
  @@map("document_signatures")
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  type        String   @default("invoice") // invoice, legal, certificate, contract, receipt, report
  format      String   @default("html")
  status      String   @default("draft") // draft, published, archived
  version     Int      @default(1)
  content     String   @default("") // HTML template content with variables
  usageCount  Int      @default(0)
  createdBy   String
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]
  versions  DocumentTemplateVersion[]

  @@map("document_templates")
}

model DocumentTemplateVersion {
  id                String   @id @default(cuid())
  templateId        String
  template          DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version           Int
  status            String   @default("previous") // current, previous
  changedBy         String
  changeDescription String   @default("")
  content           String   @default("") // HTML content snapshot
  createdAt         DateTime @default(now())

  @@unique([templateId, version])
  @@map("document_template_versions")
}

// ---------------------------------------------------------------------------
// Notification models
// ---------------------------------------------------------------------------

model NotificationTemplate {
  id         String   @id @default(cuid())
  name       String
  subject    String   @default("")
  channel    String   @default("email") // email, sms, push, in_app
  category   String   @default("general") // onboarding, security, billing, general
  status     String   @default("active") // active, draft, archived
  version    Int      @default(1)
  usageCount Int      @default(0)
  editedBy   String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliveryLogs NotificationDeliveryLog[]

  @@map("notification_templates")
}

model NotificationDeliveryLog {
  id           String    @id @default(cuid())
  templateId   String?
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName String    @default("")
  channel      String    // email, sms, push, in_app
  recipient    String
  status       String    @default("pending") // pending, sent, delivered, failed, bounced
  sentAt       DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?
  failReason   String?
  createdAt    DateTime  @default(now())

  @@map("notification_delivery_logs")
}

// ---------------------------------------------------------------------------
// File management
// ---------------------------------------------------------------------------

model File {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("document") // document, image
  size         Int      @default(0) // in bytes
  mimeType     String   @default("")
  storagePath  String   @default("") // path in storage bucket
  uploadedBy   String
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  @@map("files")
}

// ---------------------------------------------------------------------------
// Plan & payment configuration models
// ---------------------------------------------------------------------------

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  price        Int      @default(0) // in whole units (e.g. 29 = $29)
  billingCycle String   @default("Monthly") // Monthly, Yearly
  currency     String   @default("USD")
  features     String   @default("[]") // JSON array of feature strings
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paymentLinks PaymentLink[]

  @@map("plans")
}

model PaymentLink {
  id           String    @id @default(cuid())
  planId       String
  plan         Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  description  String    @default("")
  active       Boolean   @default(true)
  expiresAt    DateTime?
  createdBy    String    @default("")
  createdAt    DateTime  @default(now())

  @@map("payment_links")
}

model PaymentGateway {
  id               String   @id @default(cuid())
  name             String
  provider         String   @unique // stripe, razorpay, etc.
  enabled          Boolean  @default(false)
  mode             String   @default("test") // test, live
  publicKey        String   @default("")
  secretKey        String   @default("") // encrypted in production
  webhookSecret    String   @default("")
  webhookUrl       String   @default("")
  supportedMethods String   @default("[]") // JSON array
  currencies       String   @default("[]") // JSON array
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("payment_gateways")
}

// ---------------------------------------------------------------------------
// Audit & Compliance models (P4-F01, P4-F02)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  actor       String   @default("")
  actorEmail  String   @default("")
  actorRole   String   @default("")
  action      String   @default("Accessed") // Created, Updated, Deleted, Accessed, Exported, Login, Logout, Permission Change, Config Change
  entity      String   @default("")
  entityId    String   @default("")
  details     String   @default("")
  ip          String   @default("")
  userAgent   String   @default("")
  sessionId   String   @default("")
  isCritical  Boolean  @default(false)
  beforeJson  String   @default("") // JSON snapshot of entity before change
  afterJson   String   @default("") // JSON snapshot of entity after change
  createdAt   DateTime @default(now())

  @@index([timestamp])
  @@index([actor])
  @@index([action])
  @@index([entity])
  @@map("audit_logs")
}

model ComplianceReport {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("Custom") // SOC2, GDPR, HIPAA, PCI-DSS, Security Assessment, Banking Audit, Custom
  framework   String   @default("Custom Framework")
  period      String   @default("")
  status      String   @default("Pending") // Generated, Pending, Failed
  date        String   @default("")
  size        String   @default("—")
  findings    Int      @default(0)
  score       Int      @default(0)
  generatedBy String   @default("System")
  summary     String   @default("")
  sections    String   @default("[]") // JSON array: [{ name, score, status, details }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("compliance_reports")
}

model RetentionRule {
  id              String   @id @default(cuid())
  dataType        String
  description     String   @default("")
  retentionDays   Int      @default(365)
  action          String   @default("archive") // delete, archive, anonymize
  enabled         Boolean  @default(true)
  lastPurge       String   @default("Never")
  recordsAffected Int      @default(0)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("retention_rules")
}

model RetentionSettings {
  id                 String   @id @default("global")
  defaultRetention   Int      @default(365)
  autoDeleteEnabled  Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  @@map("retention_settings")
}

model DataExportRequest {
  id           String    @id @default(cuid())
  name         String
  dataScope    String    @default("Audit Logs") // Audit Logs, User PII, Usage Metrics, Security Events, Compliance Data, Payment Data, Tenant Data, API Logs
  format       String    @default("CSV") // CSV, JSON, PDF
  status       String    @default("Queued") // Completed, Processing, Queued, Failed
  requestedBy  String    @default("")
  requestedAt  DateTime  @default(now())
  completedAt  DateTime?
  fileSize     String?
  progress     Int       @default(0)
  reason       String    @default("")

  @@map("data_export_requests")
}

// ---------------------------------------------------------------------------
// Feature flags (P7)
// ---------------------------------------------------------------------------

model FeatureFlag {
  id                 String   @id @default(cuid())
  key                String   @unique
  name               String
  description        String   @default("")
  enabled            Boolean  @default(false)
  rolloutPercentage  Int      @default(0) // 0-100
  environment        String   @default("Production") // Production, Staging, Development
  category           String   @default("Feature") // Feature, Experiment, Ops, Release
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  overrides          FeatureFlagOverride[]

  @@map("feature_flags")
}

model FeatureFlagOverride {
  id          String      @id @default(cuid())
  flagId      String
  flag        FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  tenantCode  String
  tenantName  String      @default("")
  enabled     Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@unique([flagId, tenantCode])
  @@index([flagId])
  @@map("feature_flag_overrides")
}

// ---------------------------------------------------------------------------
// Webhook registrations
// ---------------------------------------------------------------------------

model Webhook {
  id        String   @id @default(cuid())
  name      String
  url       String
  events    String   @default("[]") // JSON array of event names
  status    String   @default("active") // active, inactive
  secret    String?  // signing secret
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhooks")
}
